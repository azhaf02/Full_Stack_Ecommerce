# Copy this file to .env and fill in the real values (never commit .env)
DATABASE_URL=postgresql://username:password@localhost:5432/your_database
SECRET_KEY=replace-this-with-your-own-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Flat tax for the whole shop as a percentage (18 = 18%). Charged on the subtotal after discount.
